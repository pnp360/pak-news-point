# Database
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Site URL (used for sitemap, RSS, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Daily News Limit (default: 100)
DAILY_NEWS_LIMIT=100

# Cloudinary (optional - for image uploads)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Google AdSense (optional)
# NEXT_PUBLIC_ADSENSE_ID=""

# Facebook Domain Verification (optional)
# FACEBOOK_VERIFICATION=""

# AI News Rewriter - Hugging Face (FREE - no token needed for rate-limited access)
# Get a free token at https://huggingface.co/settings/tokens
# HF_API_TOKEN=""
# HF_REWRITE_MODEL="google/gemma-2b-it"

# AI Image Fetcher - Pexels API (FREE - 200 req/hour)
# Get a free API key at https://www.pexels.com/api/
# PEXELS_API_KEY=""

# AI Image Fetcher - Unsplash API (FREE - 50 req/hour)
# Get a free access key at https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=""
